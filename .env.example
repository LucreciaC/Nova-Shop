# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — NOVA Shop (UCH-FyD)
# ==============================================================================

# 1. Servicio de Identidad (identity-service)
MONGO_URI=mongodb://mongodb:27017/novashop_identidad
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@uch.edu.ar
ADMIN_NOMBRE=Administrador UCH-FyD
ADMIN_PASSWORD=TuClaveAdminSegura

# 2. Servidor de Ventas (ventas-service)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/novashop_ventas
IDENTITY_JWKS_URL=http://identity-service:3001/api/v1/auth/jwks
INSTANCE_NAME=ventas-instance-1

# 3. API Gateway + Inteligencia Artificial (api-gateway)
IDENTITY_SERVICE_URL=http://identity-service:3001
VENTAS_SERVICE_URLS=http://ventas-service-1:3002,http://ventas-service-2:3003
# Opcional: Si agregás una clave gratuita de Google AI Studio (Gemini), NOVA AI usa Gemini 2.5 Flash;
# si la dejás vacía, usa automáticamente el motor local NOVA Semantic RAG Engine.
GEMINI_API_KEY=

# 4. Frontend Next.js (frontend)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080
